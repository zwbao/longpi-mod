{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zwbao/longevity-skills/schema/paper.schema.json",
  "title": "One row of registry/papers.jsonl",
  "description": "Every paper the weekly pipeline has seen, whatever became of it. The DOI is normalized (lower case, no prefix, no trailing punctuation) and unique. The same file is the literature index for tier C papers.",
  "type": "object",
  "required": ["doi", "tier", "outcome", "first_seen", "source"],
  "additionalProperties": false,
  "properties": {
    "doi": { "type": "string", "pattern": "^(10\\.[0-9]{4,9}/[^\\s。，；A-Z]+|[a-z]+:[A-Za-z0-9._/-]+)$" },
    "title": { "type": "string" },
    "journal": { "type": "string" },
    "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
    "tier": { "enum": ["A", "B", "C", "tool", "pending", "rejected"] },
    "outcome": { "enum": ["skill", "evidence", "indexed", "rejected", "pending"] },
    "skill": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "reason_zh": { "type": "string" },
    "first_seen": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source": { "enum": ["seed", "pipeline", "manual"] }
  }
}
