    },
    {
      "key": "self_health_index",
      "label_zh": "自评健康指数",
      "unit": "score",
      "note_zh": "((fair×2)+(poor×4))×(1−better×0.5+worse)，四项都给了才算。"
    },
    {
      "key": "acr_at_least_30",
      "label_zh": "尿白蛋白肌酐比是否达到 30 mg/g",
