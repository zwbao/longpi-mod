{
  "schema": "longevity-skill/1",
  "name": "pyaging",
  "kind": "tool",
  "tier": "tool",
  "species": [
    "human",
    "multi_species"
  ],
  "evidence": "method",
  "domains": [
    "工具与证据库"
  ],
  "blurb_zh": "pyaging 0.5.2（lucascamillomd/pyaging edb1b37）。在用户提供的特征矩阵上运行衰老时钟。",
  "intents": [
    "epigenetic_age"
  ],
  "tool": {
    "upstream": "https://github.com/lucascamillomd/pyaging",
    "version": "0.5.2",
    "commit": "edb1b37",
    "requires": [
      "pyaging"
    ],
    "doi": "10.1093/bioinformatics/btae200"
  },
  "entry": {
    "script": "scripts/personal_report.py",
    "runtime": "pyaging",
    "age_flag": "--age",
    "sex_flag": "--sex",
    "out_flag": "--out",
    "result_json": true
  },
  "inputs_status": "verified",
  "inputs": [
    {
      "key": "matrix",
      "label_zh": "特征矩阵（第一列样本名，其余列是探针、基因或血液化学项目）",
      "required": true,
      "from": "argument",
      "flag": "--matrix",
      "note_zh": "甲基化时钟要 0 到 1 的 β 值矩阵。IDAT 要先预处理。"
    },
    {
      "key": "clocks",
      "label_zh": "要跑的时钟名（逗号分隔，默认 horvath2013）",
      "required": false,
      "from": "argument",
      "flag": "--clocks"
    },
    {
      "key": "age",
      "label_zh": "实足年龄",
      "unit": "a",
      "range": [
        0,
        120
      ],
      "required": false,
      "from": "profile",
      "flag": "--age",
      "note_zh": "GrimAge 等时钟把实足年龄当作模型输入；其余时钟只用它算读数减实足年龄。"
    },
    {
      "key": "sex",
      "label_zh": "性别",
      "required": false,
      "from": "profile",
      "flag": "--sex",
      "note_zh": "GrimAge、GrimAge2、PCGrimAge 等时钟把性别当作模型输入（female，1 女 0 男）；缺了这些时钟不运行。"
    }
  ],
  "outputs": [
    {
