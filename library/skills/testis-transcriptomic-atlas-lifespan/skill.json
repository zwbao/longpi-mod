{
  "schema": "longevity-skill/1",
  "name": "testis-transcriptomic-atlas-lifespan",
  "kind": "paper",
  "tier": "A",
  "species": [
    "human"
  ],
  "evidence": "cross_sectional",
  "domains": [
    "卵巢与生殖"
