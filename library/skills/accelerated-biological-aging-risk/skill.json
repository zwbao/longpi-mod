  ],
  "triage": {
    "reason_zh": "用九项常规血检和实足年龄按BioAge原始系数算出个人表型年龄及与实足年龄之差。",
    "reviewed": false
  },
  "paper": {
    "doi": "10.18632/aging.101414",
    "title": "An epigenetic biomarker of aging for lifespan and healthspan",
    "title_zh": "表型年龄",
    "journal": "Aging",
    "year": 2018,
    "authors": "Levine 等",
    "article_url": "https://doi.org/10.18632/aging.101414",
    "code_url": "https://github.com/dayoonkwon/BioAge",
    "card_notes": [
      "计算器系数是 Levine 等 Aging 2018（doi:10.18632/aging.101414）的表型年龄，实现为 BioAge phenoage_calc.R 的 orig=TRUE。",
      "Gao 等 Nature Communications 2023（doi:10.1038/s41467-023-38013-7）用表型年龄研究抑郁和焦虑，没有发表这些系数。问卷切点只在交了问卷时使用，不改变表型年龄。"
    ],
    "summary_zh": "Levine 等在 2018 年用 NHANES III 的九项血液指标和实足年龄建立表型年龄，用来概括死亡风险。个人报告按 BioAge 包 phenoage_calc.R 的 orig=TRUE 系数计算这个年龄，以及它和实足年龄的差，并写明 10 年死亡数字是模型估计，不是你的风险，也不是寿命。Gao 等 2023 年用表型年龄研究抑郁和焦虑，没有发表这些系数；问卷切点只在交了问卷时使用，不改变算出的年龄。",
    "summary_status": "draft"
  },
