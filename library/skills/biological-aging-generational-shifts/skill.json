    "measurements_flag": "--measurements",
    "measurements_header": [
      "item",
      "value",
      "unit"
    ],
    "age_flag": "--age",
    "medications_flag": "--medications",
    "labs_flag": "--labs",
    "out_flag": "--out",
    "result_json": true
  },
  "inputs_status": "verified",
  "inputs": [
    {
      "key": "phenoage",
      "label_zh": "表型年龄",
      "aliases": [
        "PhenoAge",
        "phenotypic age",
        "血检表型年龄",
        "Levine phenotypic age"
